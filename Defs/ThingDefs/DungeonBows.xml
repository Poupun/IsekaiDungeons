  <!-- ===== [SSS] Nebula Star — the storm ===== -->
  <ThingDef ParentName="BaseWeapon">
    <defName>IsekaiDungeons_NebulaStar</defName>
    <label>[SSS-Rank] Nebula Star</label>
    <description>There is a four-pointed star set where the arrow rest should be, and it is not attached to anything. It holds its position when the bow moves and it stays the same distance out. Four shafts leave together, and they do not go where the bow is pointed so much as where the star has already decided.\n\nAimed fire is not what this is for. A line of things coming at you is. Nobody has ever reported it being given to them indoors, or in daylight.</description>
    <graphicData>
      <texPath>Things/Weapons/Nebula_Star</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.70,1.66)</drawSize>
    </graphicData>
    <techLevel>Ultra</techLevel>
    <ignoreIllegalLabelCharacterConfigError>true</ignoreIllegalLabelCharacterConfigError>
    <uiIconScale>1.05</uiIconScale>
    <soundInteract>Bow_Large</soundInteract>
    <statBases>
      <MarketValue>10500</MarketValue>
      <MaxHitPoints>270</MaxHitPoints>
      <Mass>2.4</Mass>
      <Flammability>0.1</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
      <!-- THE WORST ACCURACY IN THE LINE, deliberately. It puts 80 damage
           into the air per cycle - far and away the most - and loses a
           fifth of it to spread. A barrage is allowed to be wasteful. -->
      <AccuracyTouch>0.82</AccuracyTouch>
      <AccuracyShort>0.90</AccuracyShort>
      <AccuracyMedium>0.78</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>1.10</RangedWeapon_Cooldown>
    </statBases>
    <weaponClasses><li>Ranged</li><li>RangedHeavy</li><li>Ultratech</li></weaponClasses>
    <weaponTags><li>IsekaiDungeonArtifact</li></weaponTags>
    <tradeability>Sellable</tradeability>   <!-- gate rewards only: players may sell, traders never stock -->
    <thingCategories><li>WeaponsRanged</li></thingCategories>
    <equippedStatOffsets>
      <MoveSpeed>0.20</MoveSpeed>
      <MeleeDodgeChance>0.12</MeleeDodgeChance>
    </equippedStatOffsets>
    <comps>
      <li><compClass>CompQuality</compClass></li>
      <li><compClass>IsekaiDungeons.CompArtifactQuality</compClass></li>
    </comps>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>IsekaiDungeons_Arrow_NebulaStar</defaultProjectile>
        <warmupTime>1.20</warmupTime>
        <burstShotCount>4</burstShotCount>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <range>29.9</range>
        <soundCast>Bow_Large</soundCast>
      </li>
    </verbs>
    <tools>
      <li><label>limb</label><capacities><li>Blunt</li><li>Poke</li></capacities><power>17</power><cooldownTime>1.9</cooldownTime><armorPenetration>0.16</armorPenetration></li>
    </tools>
  </ThingDef>

  <!-- ===== [SSS] Unicorn Star — the lance ===== -->
  <ThingDef ParentName="BaseWeapon">
    <defName>IsekaiDungeons_UnicornStar</defName>
    <label>[SSS-Rank] Unicorn Star</label>
    <description>A single spiral horn bent into a bow, which should not be possible and has never been repeated. It looses one shaft, slowly, and that shaft arrives at a range where the archer is not yet a shape to the people it lands among.\n\nThere is no second arrow because there has never yet needed to be one. The bearer it was given to was seven years old and gave it back within the hour; the guild has her statement, and it is one line long.</description>
    <graphicData>
      <texPath>Things/Weapons/Unicorn_Star</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.77,1.66)</drawSize>
    </graphicData>
    <techLevel>Ultra</techLevel>
    <ignoreIllegalLabelCharacterConfigError>true</ignoreIllegalLabelCharacterConfigError>
    <uiIconScale>1.05</uiIconScale>
    <soundInteract>Bow_Large</soundInteract>
    <statBases>
      <MarketValue>10800</MarketValue>
      <MaxHitPoints>290</MaxHitPoints>
      <Mass>3.0</Mass>
      <Flammability>0.1</Flammability>
      <DeteriorationRate>0.4</DeteriorationRate>
      <!-- Longest reach in the mod and it barely drops off at all. Bad in
           your face, on purpose: this is an opening weapon, not a last
           resort. -->
      <AccuracyTouch>0.72</AccuracyTouch>
      <AccuracyShort>0.94</AccuracyShort>
      <AccuracyMedium>0.98</AccuracyMedium>
      <AccuracyLong>0.94</AccuracyLong>
      <RangedWeapon_Cooldown>1.00</RangedWeapon_Cooldown>
    </statBases>
    <weaponClasses><li>Ranged</li><li>RangedHeavy</li><li>LongShots</li><li>Ultratech</li></weaponClasses>
    <weaponTags><li>IsekaiDungeonArtifact</li></weaponTags>
    <tradeability>Sellable</tradeability>   <!-- gate rewards only: players may sell, traders never stock -->
    <thingCategories><li>WeaponsRanged</li></thingCategories>
    <!-- 76 damage at 0.70 AP in one shaft: the single biggest hit anywhere
         in the mod, melee included. It is also the slowest bow here and it
         weighs three kilos, which is the whole trade. -->
    <equippedStatOffsets>
      <ShootingAccuracyPawn>0.30</ShootingAccuracyPawn>
      <MoveSpeed>-0.15</MoveSpeed>
    </equippedStatOffsets>
    <comps>
      <li><compClass>CompQuality</compClass></li>
      <li><compClass>IsekaiDungeons.CompArtifactQuality</compClass></li>
    </comps>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>IsekaiDungeons_Arrow_UnicornStar</defaultProjectile>
        <warmupTime>1.80</warmupTime>
        <range>37.9</range>
        <soundCast>Bow_Large</soundCast>
      </li>
    </verbs>
    <tools>
      <li><label>horn</label><capacities><li>Poke</li><li>Blunt</li></capacities><power>22</power><cooldownTime>2.0</cooldownTime><armorPenetration>0.25</armorPenetration></li>
    </tools>
  </ThingDef>

