  <!-- ===== [SS] Butterfly Heart — the flurry ===== -->
  <ThingDef ParentName="BaseWeapon">
    <defName>IsekaiDungeons_ButterflyHeart</defName>
    <label>[SS-Rank] Butterfly Heart</label>
    <description>The wings open when it is drawn and fold when it is set down, and nobody has established what they are made of, because the material stops being interesting the moment the bow is no longer held. Three shafts leave it together and spread as they fly.\n\nThat is a wonderful thing to watch happen to a crowd and a disappointing thing to watch happen to one armoured man. It was given to somebody who was already dying, which is the detail every account agrees on and none of them explains.</description>
    <graphicData>
      <texPath>Things/Weapons/Butterfly_Heart</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.66,1.58)</drawSize>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <ignoreIllegalLabelCharacterConfigError>true</ignoreIllegalLabelCharacterConfigError>
    <uiIconScale>1.05</uiIconScale>
    <soundInteract>Bow_Recurve</soundInteract>
    <statBases>
      <MarketValue>7400</MarketValue>
      <MaxHitPoints>230</MaxHitPoints>
      <Mass>1.6</Mass>
      <Flammability>0.2</Flammability>
      <DeteriorationRate>0.8</DeteriorationRate>
      <AccuracyTouch>0.88</AccuracyTouch>
      <AccuracyShort>0.94</AccuracyShort>
      <AccuracyMedium>0.84</AccuracyMedium>
      <AccuracyLong>0.60</AccuracyLong>
      <RangedWeapon_Cooldown>1.00</RangedWeapon_Cooldown>
    </statBases>
    <weaponClasses><li>Ranged</li><li>RangedLight</li><li>ShortShots</li></weaponClasses>
    <weaponTags><li>IsekaiDungeonArtifact</li></weaponTags>
    <tradeability>Sellable</tradeability>   <!-- gate rewards only: players may sell, traders never stock -->
    <thingCategories><li>WeaponsRanged</li></thingCategories>
    <!-- Three shafts of 20 is the most ARROWS in the air of any bow here,
         and the least behind each one. Crowd weapon, plainly. -->
    <equippedStatOffsets>
      <MoveSpeed>0.30</MoveSpeed>
      <MeleeDodgeChance>0.15</MeleeDodgeChance>
    </equippedStatOffsets>
    <comps>
      <li><compClass>CompQuality</compClass></li>
      <li><compClass>IsekaiDungeons.CompArtifactQuality</compClass></li>
    </comps>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>IsekaiDungeons_Arrow_ButterflyHeart</defaultProjectile>
        <warmupTime>1.10</warmupTime>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>7</ticksBetweenBurstShots>
        <range>27.9</range>
        <soundCast>Bow_Recurve</soundCast>
      </li>
    </verbs>
    <tools>
      <li><label>limb</label><capacities><li>Blunt</li><li>Poke</li></capacities><power>13</power><cooldownTime>1.9</cooldownTime><armorPenetration>0.12</armorPenetration></li>
    </tools>
  </ThingDef>

  <!-- ===== [SS] Sea Will — the steady one ===== -->
  <ThingDef ParentName="BaseWeapon">
    <defName>IsekaiDungeons_SeaWill</defName>
    <label>[SS-Rank] Sea Will</label>
    <description>Blue the whole way through, and the blue moves — slowly, the way deep water moves, whether or not anyone is holding it. It is the steadiest thing in the vault. It does not hit hardest and it does not reach furthest. It does the same correct thing every time it is asked, for as long as it is asked, which over a long engagement is worth more than either.\n\nThe bearer it was given to walked out of a flooded gate eleven days after the gate closed. She would not say what she had agreed to and she never put it down again.</description>
    <graphicData>
      <texPath>Things/Weapons/Sea_Will</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.58,1.58)</drawSize>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <ignoreIllegalLabelCharacterConfigError>true</ignoreIllegalLabelCharacterConfigError>
    <uiIconScale>1.05</uiIconScale>
    <soundInteract>Bow_Recurve</soundInteract>
    <statBases>
      <MarketValue>7600</MarketValue>
      <MaxHitPoints>300</MaxHitPoints>
      <Mass>2.0</Mass>
      <Flammability>0.1</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
      <!-- No weak band. The flattest accuracy profile in the line, which is
           the whole identity: it is never the wrong bow for the range. -->
      <AccuracyTouch>0.86</AccuracyTouch>
      <AccuracyShort>0.97</AccuracyShort>
      <AccuracyMedium>0.93</AccuracyMedium>
      <AccuracyLong>0.78</AccuracyLong>
      <RangedWeapon_Cooldown>1.10</RangedWeapon_Cooldown>
    </statBases>
    <weaponClasses><li>Ranged</li><li>RangedHeavy</li></weaponClasses>
    <weaponTags><li>IsekaiDungeonArtifact</li></weaponTags>
    <tradeability>Sellable</tradeability>   <!-- gate rewards only: players may sell, traders never stock -->
    <thingCategories><li>WeaponsRanged</li></thingCategories>
    <!-- AimingDelayFactor is a multiplier with default 1, so a NEGATIVE
         offset is the buff: it aims faster. Paired with the accuracy
         bonus this is the bow that simply does not miss. -->
    <equippedStatOffsets>
      <ShootingAccuracyPawn>0.25</ShootingAccuracyPawn>
      <AimingDelayFactor>-0.15</AimingDelayFactor>
    </equippedStatOffsets>
    <comps>
      <li><compClass>CompQuality</compClass></li>
      <li><compClass>IsekaiDungeons.CompArtifactQuality</compClass></li>
    </comps>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>IsekaiDungeons_Arrow_SeaWill</defaultProjectile>
        <warmupTime>1.00</warmupTime>
        <burstShotCount>2</burstShotCount>
        <ticksBetweenBurstShots>9</ticksBetweenBurstShots>
        <range>30.9</range>
        <soundCast>Bow_Recurve</soundCast>
      </li>
    </verbs>
    <tools>
      <li><label>limb</label><capacities><li>Blunt</li><li>Poke</li></capacities><power>15</power><cooldownTime>1.9</cooldownTime><armorPenetration>0.14</armorPenetration></li>
    </tools>
  </ThingDef>

