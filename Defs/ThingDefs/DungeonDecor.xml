<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    DUNGEON DECOR — vanilla art on dungeon-owned defs.

    Every piece here borrows a vanilla texture and nothing else. The source def
    is resolved through its inheritance, and only what decides the LOOK is
    copied: graphic, footprint, altitude, drawer, and the glow and flame comps.
    Everything that makes vanilla decor unsafe in a dungeon is left behind, and
    the reasons are in DUNGEON_DECOR_DESIGN.md section 2:

      - no costList, no stuff:   an ownerless building deconstructs without a
                                  claim and refunds half its cost, and tower and
                                  multi-floor maps rebuild on every visit
      - no minifiedDef:          it could be uninstalled and sold
      - no CompRefuelable:       the light would burn out between visits
      - no CompHeatPusher:       a dungeon full of torches would warm itself
                                  and fight the climate spines
      - no art, assignment, ritual or style comps: pure scenery

    The base below makes them unclaimable and undeconstructible on top of that.
    DungeonDecorSetDef.ConfigErrors re-checks every piece a set uses at load, so
    a vanilla def added to a set by mistake reports itself in the log.

    Stone and wood colours stand in for the stuff tint the vanilla def would
    have taken from what it was built of. DLC pieces carry MayRequire and simply
    do not exist without their expansion; the sets skip them.

    Generated from the vanilla defs, then committed. Edit by hand freely.
  -->

  <ThingDef Name="IsekaiDungeons_DecorBase" Abstract="True">
    <category>Building</category>
    <thingClass>Building</thingClass>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.3</fillPercent>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

