    <smoothWalls>true</smoothWalls>
    <corridorLight>IsekaiDungeons_Decor_WallTorch</corridorLight>
    <corridorLightFrom>Stronghold</corridorLightFrom>
    <corridorFilth>
      <li>Filth_Ash</li>
      <li>Filth_BlastMark</li>
    </corridorFilth>
    <entries>
      <li><filth>Filth_Ash</filth><cost>0.3</cost><weight>3</weight><cluster>2~4</cluster></li>
      <li><filth>Filth_BlastMark</filth><cost>0.3</cost><weight>1.5</weight><cluster>1~2</cluster></li>
      <li><filth>Filth_DarkBlood</filth><mayRequire>Ludeon.RimWorld.Anomaly</mayRequire><cost>0.3</cost><weight>1.5</weight><cluster>1~3</cluster><from>Lair</from></li>
      <li><filth>Filth_TwistedFlesh</filth><mayRequire>Ludeon.RimWorld.Anomaly</mayRequire><cost>0.4</cost><weight>0.8</weight><cluster>1~2</cluster><from>Temple</from></li>

      <li><thing>IsekaiDungeons_Decor_Torch</thing><placement>Corner</placement><cost>1</cost><weight>2.5</weight><maxPerRoom>2</maxPerRoom></li>
      <li><thing>IsekaiDungeons_Decor_BloodTorch</thing><mayRequire>Ludeon.RimWorld.Biotech</mayRequire><placement>Corner</placement><cost>1</cost><weight>3</weight><maxPerRoom>2</maxPerRoom></li>
      <li><thing>IsekaiDungeons_Decor_WallTorch</thing><placement>WallAttached</placement><cost>0.8</cost><weight>1.5</weight><maxPerRoom>3</maxPerRoom><from>Lair</from></li>
