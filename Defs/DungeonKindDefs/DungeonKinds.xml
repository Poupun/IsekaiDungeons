<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    ═══ THE GENERIC FALLBACK DUNGEON ═══

    IsekaiDungeons_BreakDungeon is the plain, unthemed gate — and it is the
    mod's safety net. Three rules keep it that way; do not relax them.

    1. THE defName IS FROZEN. IsekaiDungeonsDefOf resolves it, and five C#
       call sites fall back to it when a gate/map has lost its kind reference
       (Building_DungeonGate.SpawnSetup, DungeonMapComponent.KindDef,
       GenStep_DungeonLayout, GenStep_DungeonPopulation, DungeonLootGenerator).
       DefOf resolution is hard-failing: renaming this def red-errors on load.
       It is also the def IncidentWorker_DungeonBreak asks for the rank roll.

    2. IT INHERITS FROM NOTHING. The catalogue dungeons share the abstract
       IsekaiDungeonBase in Dungeons_Low.xml; this def deliberately keeps its
       own copies of all five rank curves and every layout field so it stays
       loadable on its own. It is the one def that must exist no matter what
       else in the Defs folder is broken, mispatched or mid-edit.

    3. IT IS ALWAYS AVAILABLE. No roster, no bosses, requiresFullRoster false
       — so it populates from the generic rank-banded spawn providers and
       DungeonKindDef.Available is unconditionally true. That is what
       guarantees DungeonKindSelector.SelectForRank never comes up empty: with
       a full rank band (F→Nation) it is a valid candidate at every rank, for
       every mod combination, including a bare install with neither Isekai
       Creatures nor any DLC.

    Its selectionWeight is deliberately low (0.25 against a themed dungeon's
    1.0). Themed dungeons should win nearly every roll where any exist; this
    one is the floor, not the norm.

    Curve X axis everywhere: (int)MobRankTier — 0=F 1=E 2=D 3=C 4=B 5=A
    6=S 7=SS 8=SSS 9=Nation. SimpleCurve interpolates between points and
    clamps outside the defined range, so sparse anchor lists are fine.
  -->

  <IsekaiDungeons.DungeonKindDef>
    <defName>IsekaiDungeons_BreakDungeon</defName>
    <!-- Stand-in for missing add-on content: stepped down whenever
         themed dungeons exist at the same rank. See DungeonKindDef. -->
    <vanillaBackbone>true</vanillaBackbone>
    <label>unstable gate</label>
    <description>A gate with nothing behind it worth a name — raw rock, carved halls, and whatever the mana in the air happened to grow into. Gates like this open more often than the famous ones and get written up in one line of the guild ledger. It will still kill an unprepared party, and it will still break on schedule.</description>

    <gateDef>IsekaiDungeons_DungeonGate</gateDef>
    <mapGenerator>IsekaiDungeons_Dungeon</mapGenerator>

    <!-- ── Selection ──
         Full band: this def is the guaranteed candidate at EVERY rank, so it
         must never be narrowed. Low weight so it loses to themed dungeons
         wherever the catalogue has any. -->
    <minRank>F</minRank>
    <maxRank>SSS</maxRank>
    <selectionWeight>0.25</selectionWeight>

    <!-- Pocket-map edge length in cells. Kept small: dungeons are corridors and
         rooms, not open terrain, and pocket maps tick like any other map. -->
    <mapSizeByRank>
      <points>
        <li>(0, 150)</li>
        <li>(1, 165)</li>
        <li>(2, 180)</li>
        <li>(3, 200)</li>
        <li>(4, 220)</li>
        <li>(5, 240)</li>
        <li>(6, 260)</li>
        <li>(7, 275)</li>
        <li>(8, 290)</li>
        <li>(9, 300)</li>
      </points>
    </mapSizeByRank>

    <!-- COMBAT rooms only — the entry room, boss room and treasure side-rooms
         are added on top by the layout planner. -->
    <roomCountByRank>
      <points>
        <li>(0, 4)</li>
        <li>(2, 5)</li>
        <li>(4, 7)</li>
        <li>(6, 9)</li>
        <li>(8, 11)</li>
        <li>(9, 12)</li>
      </points>
    </roomCountByRank>

    <!-- Per-room creature budget in combatPower points, before the front-to-back
         ramp (0.6x first room … 1.4x last room) applied by the population step. -->
    <encounterPointsByRank>
      <points>
        <li>(0, 120)</li>
        <li>(1, 180)</li>
        <li>(2, 260)</li>
        <li>(3, 380)</li>
        <li>(4, 550)</li>
        <li>(5, 800)</li>
        <li>(6, 1200)</li>
        <li>(7, 1800)</li>
        <li>(8, 2600)</li>
        <li>(9, 3500)</li>
      </points>
    </encounterPointsByRank>

    <!-- Days from gate spawn to the break.
         A QUADRUM at the bottom of the ladder (15 days), rising to 25 at
         Nation. Higher ranks get MORE time, not less: the fight is bigger and
         the colony needs room to outfit an expedition rather than throw
         whoever is nearest at it.

         Fifteen rather than the old four because a gate is a PLACE the colony
         plans a trip to, not a timer it panics at. Four days meant a gate that
         opened while the caravan was away was simply lost, and the only way to
         engage with one was to drop what you were doing. -->
    <breakTimerDaysByRank>
      <points>
        <li>(0, 15)</li>
        <li>(2, 17)</li>
        <li>(4, 19)</li>
        <li>(6, 21)</li>
        <li>(8, 24)</li>
        <li>(9, 25)</li>
      </points>
    </breakTimerDaysByRank>

    <!-- Clear-loot market value target — ~1.5x a same-rank guild contract
         (DungeonTunables.LootValueMultiplier is already baked into this table;
         the loot generator consumes these numbers as-is). -->
    <lootValueByRank>
      <points>
        <li>(0, 270)</li>
        <li>(1, 540)</li>
        <li>(2, 1080)</li>
        <li>(3, 2160)</li>
        <li>(4, 4320)</li>
        <li>(5, 8640)</li>
        <li>(6, 17280)</li>
        <li>(7, 34560)</li>
        <li>(8, 69120)</li>
        <li>(9, 138240)</li>
      </points>
    </lootValueByRank>

    <!-- ── Layout ──
         Carve into the underground generator's solid rock: the leftover rock is
         the wall shell, which needs no wallDef/wallStuff and therefore no
         assumptions about which stuff types a given modlist provides. -->
    <layoutMode>Carve</layoutMode>
    <roofed>true</roofed>

    <!-- floorTerrain deliberately unset: the layout step then keeps the mined
         rock's own natural terrain, so this gate looks like whatever rock the
         map rolled. Themed dungeons are the ones that state a floor. -->

    <!-- 13 max is a ROOF-SUPPORT constraint: rooms keep a thin-rock roof and
         vanilla roof support reaches 6 cells from a wall, so a room wider than
         13 cells has unsupported center cells that collapse on generation.
         Do not raise without reworking the layout step's roofing. -->
    <roomSizeRange>8~12</roomSizeRange>
    <treasureRoomCountRange>0~2</treasureRoomCountRange>
    <corridorWidth>2</corridorWidth>

    <!-- ── Roster ──
         Intentionally empty. DungeonRoster falls through to
         DungeonSpawnResolver's generic rank-banded providers, which work off
         whatever bestiary the install actually has. requiresFullRoster false
         keeps Available true even on a bare vanilla install — this def must
         never be able to drop out. -->
    <requiresFullRoster>false</requiresFullRoster>

    <bossIsElite>true</bossIsElite>

  </IsekaiDungeons.DungeonKindDef>

</Defs>
